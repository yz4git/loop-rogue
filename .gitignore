# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# framework/build output
/.next/
/out/
/dist/
/.vinext/

# local OS/editor files
.DS_Store
.vscode/
.idea/

# credentials and local secrets
.env*
!.env.example
.dev.vars*
*.pem
*.key
*.p12
*.pfx
*.jks
credentials*.json
secrets*.json

# debug/logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# deployment/runtime caches
.vercel
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# typescript
next-env.d.ts
*.tsbuildinfo
